project Default is

   for Object_Dir use "obj";
   for Main use ("Test_Program");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0", "-gnata", "-gnatyr", "-gnatwa");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("-j0");
   end Prove;

end Default;
